NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Supabase dashboard: Project Settings -> API -> Project API keys -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Password for /moderacion. Pick your own value.
ADMIN_PASSWORD=change-me

# Signs the /moderacion session cookie. Any long random string; rotate it to force-logout everyone.
ADMIN_SESSION_SECRET=change-me-too
